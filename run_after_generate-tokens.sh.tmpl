{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Reads all *TOKEN_* entries from macOS keychain and writes ~/.zsh/token.zsh.

TOKEN_FILE="${HOME}/.zsh/token.zsh"
mkdir -p "$(dirname "$TOKEN_FILE")"

{
  printf '# vim: ft=zsh\n'
  printf '# Generated by chezmoi run_after_generate-tokens.sh — do not edit\n\n'

  # GitHub classic API tokens (GITHUB_API_TOKEN_*)
  # - [x] repo
  # - [x] admin:org
  # - [x] project
  # All tokens matching *TOKEN* are exported.
  security dump-keychain 2>/dev/null \
    | awk -F'"' '/^    "svce"/{print $4}' \
    | grep 'TOKEN' \
    | while read -r svc; do
        val=$(security find-generic-password -s "$svc" -w 2>/dev/null) || continue
        printf 'export %s=%s\n' "$svc" "$val"
      done
} > "$TOKEN_FILE"
{{- end }}
