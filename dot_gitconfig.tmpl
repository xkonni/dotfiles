# vim: filetype=gitconfig
# set your user tokens as environment variables, such as ~/.secrets
# See the README for examples.
[color]
    ui = true
[color "branch"]
    current = 15 4
    local = 12 normal
    remote = 6 normal
    plain = normal
    upstream = 6 normal
[color "diff"]
    meta = 8 normal
    frag = 8 normal
    old = 15 1
    new = 15 2
    commit = 3 normal
    newMoved = 15 5
    oldMovedAlternativeDimmed = 15 8 dim
    oldMovedAlternative = 15 8
    contextBold = normal bold
    newBold = 15 2 bold
    context = normal
    oldMoved = 15 3
    oldBold = 15 1 bold
    newMovedDimmed = 15 5 dim
    func = 8 normal
    newDimmed = 15 2 dim
    newMovedAlternative = 15 4
    newMovedAlternativeDimmed = 15 4 dim
    whitespace = normal 9
    oldMovedDimmed = 15 3 dim
    oldDimmed = 15 1 dim
    contextDimmed = normal dim
[color "status"]
    branch = 12 normal
    added = 10 normal
    updated = 10 normal
    localbranch = 12 normal
    changed = 11 normal
    header = normal
    remotebranch = 6 normal
    nobranch = 1 normal
    unmerged = 9 normal
    untracked = 3 normal
[color "remote"]
    hint = 8 normal
    success = 10 normal
    error = 9 normal
    warning = 11 normal
[color "interactive"]
    header = 8 normal bold
    prompt = 15 4
    help = 8 normal
    error = 9 normal
[color "decorate"]
    branch = 12 normal
    tag = 5 normal
    remotebranch = 6 normal
    stash = 3 normal
    grafted = 1 normal
    HEAD = 7 4
[alias]
    # add
    a = add                           # add
    chunkyadd = add --patch           # stage commits chunk by chunk

    # via http://blog.apiaxle.com/post/handy-git-tips-to-stop-you-getting-fired/
    snapshot = !git stash save "snapshot: $(date)" && git stash apply "stash@{0}"
    snapshots = !git stash list --grep snapshot

    #via http://stackoverflow.com/questions/5188320/how-can-i-get-a-list-of-git-branches-ordered-by-most-recent-commit
    recent-branches = !git for-each-ref --count=15 --sort=-committerdate refs/heads/ --format='%(refname:short)'

    # branch
    b = branch -v                     # branch (verbose)

    # commit
    c = commit -m                     # commit with message
    ca = commit -am                   # commit all with message
    cam = commit --amend              # ammend your last commit
    caam = commit -a --amend          # ammend all to your last commit
    # uncommit
    uncommit = reset HEAD^

    # checkout
    co = checkout                     # checkout
    nb = checkout -b                  # create and switch to a new branch (mnemonic: "git new branch branchname...")

    # cherry-pick
    cp = cherry-pick                  # grab a change from a branch

    # diff
    d = diff                          # diff unstaged changes
    dc = diff --cached                # diff staged changes
    last = diff HEAD^                 # diff last committed change

    # log
    l  = log --graph --date=short -n 10
    ll = log --graph --date=short
    lf = log --graph --date=short -n 5 --pretty=format:\"%C(33)%ad%Creset %C(136)%H%C(70)%d%Creset%n%C(33)Author: %C(162)%an <%ae>%Creset%n%C(33)Commit: %C(162)%cn <%ce>%Creset%n%n    %C(33)%s%Creset%n%n%b\"
    llf = log --graph --date=short --pretty=format:\"%C(33)%ad%Creset %C(136)%H%C(70)%d%Creset%n%C(33)Author: %C(162)%an <%ae>%Creset%n%C(33)Commit: %C(162)%cn <%ce>%Creset%n%n    %C(33)%s%Creset%n%n%b\"
    changes = log --pretty=format:\"%h %cr %cn %C70%s%Creset\" --name-status
    short = log --pretty=format:\"%h %cr %cn %C70%s%Creset\"
    simple = log --pretty=format:\" * %s\"
    shortnocolor = log --pretty=format:\"%h %cr %cn %s\"
    lp  = log -n 1 -p
    lr  = log --format=full --left-right

    # pull
    pl = pull --rebase                # pull with rebase

    # push
    ps = push                         # push
    psf = push -f                     # push

    # rebase
    re = rebase                       # rebase
    rc = rebase --continue            # continue rebase
    rs = rebase --skip                # skip rebase
    ra = rebase --abort               # abort rebase
    reom = rebase origin/main         # rebase origin/main
    reoms  = rebase origin/master     # rebase origin/master

    # remote
    r = remote -v                     # show remotes (verbose)
    ru = remote update                # update remotes

    # reset
    unstage = reset HEAD              # remove files from index (tracking)
    uncommit = reset --soft HEAD^     # go back before last commit, with files in uncommitted state
    filelog = log -u                  # show changes to a file
    mt = mergetool                    # fire up the merge tool

    # stash
    ss = stash                        # stash changes
    sl = stash list                   # list stashes
    sa = stash apply                  # apply stash (restore changes)
    sd = stash drop                   # drop stashes (destory changes)

    # status
    s = status                        # status
    st = status                       # status
    stat = status                     # status

    # tag
    t = tag -n                        # show tags with <n> lines of each tag message

    # whatchanged
    w  = log --raw --no-merges -n 10
    wv = log --raw --no-merges
    wq = log --raw --no-merges -n 1

    # force push to remote branch with the same name
    rv = !git push origin +$(git rev-parse --abbrev-ref HEAD)

[format]
    pretty = format:%C(33)%ad%Creset %C(136)%h%C(70)%d%Creset %C(33)%s %C(162) [%an]%Creset

[mergetool]
    prompt = false

[mergetool "mvimdiff"]
    cmd="mvim -c 'Gdiff' $MERGED"     # use fugitive.vim for 3-way merge
    keepbackup=false

[merge]
    summary = true
    verbosity = 1
    tool = mvimdiff

[apply]
    whitespace = nowarn

[branch]
    autosetupmerge = true

[push]
    # 'git push' will push the current branch to its tracking branch
    # the usual default is to push all branches
    default = upstream

[core]
    autocrlf = false
    editor = vim
    excludesfile = ~/.gitignore
    pager = less -FerXj4
    # gitproxy = git-proxy

[advice]
    statusHints = false

[diff]
    # Git diff will use (i)ndex, (w)ork tree, (c)ommit and (o)bject
    # instead of a/b/c/d as prefixes for patches
    mnemonicprefix = true
    algorithm = patience
    colorMoved = zebra

[rerere]
    # Remember my merges
    # http://gitfu.wordpress.com/2008/04/20/git-rerere-rereremember-what-you-did-last-time/
    enabled = true

[user]
    email = {{ (index . "email") | default "xkonni@posteo.de" | quote }}
    name = {{ (index . "name") | default "xkonni" | quote }}

[credential]
    helper = cache --timeout 3600

[pull]
    rebase = true

[init]
    defaultBranch = main

[oh-my-zsh]
    hide-dirty = 1
    hide-status = 1

[include]
    path = ~/.gitconfig_extra

