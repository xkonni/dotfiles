## GLOBAL OPTIONS

# default termtype
set -g default-terminal screen-256color

# Ring the bell if any background window rang a bell
set -g bell-action any

# Use vi keybindings for tmux commandline input.
# Note that to get command mode you need to hit ESC twice...
set -g status-keys vi

# Use vi keybindings in copy and choice modes
setw -g mode-keys vi

# mouse on (off in devcontainer — mouse copy path mangles UTF-8 glyphs)
{{ if .devcontainer -}}
set -g mouse off
{{- else -}}
set -g mouse on
{{- end }}

# No escape time for vi mode
set -sg escape-time 200
set -sg repeat-time 600

# Set XTerm compatibility
set -g xterm-keys on

# Bigger history
set -g history-limit 10000

# set first window to index 1 (not 0) to map more to the keyboard layout...
set-option -g base-index 1
set-window-option -g pane-base-index 1

# color scheme (styled as vim-powerline)
# E0B0:  E0B1:  E0B2:  E0B3:  E0B4
FG0=colour239   # grey
FG1=colour245   # lighter grey, 1C1C1C
FG2=colour33    # blue, 0087ff
FG2_HL=colour39 # blue, 0087ff
BG=colour235    # 262626
# styles
set-option -g status-style "fg=$FG1,bg=$BG"
set-option -g message-style "fg=$FG2,bg=$BG"
set-option -g message-command-style "fg=$FG2,bg=$BG"
set-option -g mode-style "fg=$FG2,bg=$BG"
set-option -g pane-border-style "fg=$FG1,bg=$BG"
set-option -g pane-active-border-style "fg=$FG2,bg=$BG"
# status left
set -g status-left-length 40
set -g status-left "#{?client_prefix,#[fg=$FG2_HL#,bold],#[fg=$FG2#,bold]}#(hostname | cut -d'.' -f -2) #[fg=$FG1,bold]#S  "
# status center
set -g window-status-format "#{?client_prefix,#[fg=$FG1#,bold],#[fg=$FG0#,bold]}#I-#W "
set -g window-status-current-format "#{?client_prefix,#[fg=$FG2_HL#,bold],#[fg=$FG2#,bold]}#I-#W "
# status right - with loadavg
set -g status-right-length 50
set -g status-right "  #[fg=$FG1,bold]#{sysstat_cpu}#[fg=$FG1]  #{sysstat_mem}#[fg=$FG1,bold]  #{sysstat_loadavg}#[fg=$FG1,bold]  %H:%M"
# status right - without loadavg
# set -g status-right-length 30
# set -g status-right "  #[fg=$FG1,bold]#{sysstat_cpu}#[fg=$FG1]  #{sysstat_mem}#[fg=$FG1,bold]#[fg=$FG1,bold]  %H:%M"

# sysstat colors
set -g @sysstat_cpu_color_low "colour70"
set -g @sysstat_cpu_color_medium "colour214"
set -g @sysstat_cpu_color_stress "colour160"
set -g @sysstat_mem_color_low "colour70"
set -g @sysstat_mem_color_medium "colour214"
set -g @sysstat_mem_color_stress "colour160"

# KEYBINDS
# prefix
unbind C-a
set -g prefix C-b
bind b send-prefix

# Create splits and vertical splits
bind-key v split-window -h -l 50% -c "#{pane_current_path}"
bind-key ^V split-window -h -l 50% -c "#{pane_current_path}"
bind-key s split-window -l 50% -c "#{pane_current_path}"
bind-key ^S split-window -l 50% -c "#{pane_current_path}"

# Pane resize in all four directions using vi bindings.
# Can use these raw but I map them to shift-ctrl-<h,j,k,l> in iTerm.
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Pane switching
unbind Left
unbind Down
unbind Up
unbind Right
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R

# Smart pane switching with awareness of vim splits.
# Source: https://github.com/christoomey/vim-tmux-navigator
bind -n C-h run "(tmux display-message -p '#{pane_current_command}' | grep -iqE '(^|\/)g?(view|vim?)(diff)?$' && tmux send-keys C-h) || tmux select-pane -L"
bind -n C-j run "(tmux display-message -p '#{pane_current_command}' | grep -iqE '(^|\/)g?(view|vim?)(diff)?$' && tmux send-keys C-j) || tmux select-pane -D"
bind -n C-k run "(tmux display-message -p '#{pane_current_command}' | grep -iqE '(^|\/)g?(view|vim?)(diff)?$' && tmux send-keys C-k) || tmux select-pane -U"
bind -n C-l run "(tmux display-message -p '#{pane_current_command}' | grep -iqE '(^|\/)g?(view|vim?)(diff)?$' && tmux send-keys C-l) || tmux select-pane -R"

# new windows/pane in $PWD
bind c new-window -c "#{pane_current_path}"

# force a reload of the config file
unbind r
bind r source-file ~/.tmux.conf \; display "config reloaded!"

# Swap windows
bind-key m command-prompt -p "move window to:"  "swap-window -t '%%'"
# interactive
# bind-key m choose-window "swap-window -t '%%'"

# Join pane - counterpart to break-pane on !
# -t move current window to dest
# -s move dest to current window
# bind-key @ command-prompt -p "join pane to:"  "join-pane -t ':%%'"
bind-key @ choose-window "join-pane -t '%%'"

# rename-window on comma
# rename-session on dot
bind-key . command-prompt -p "rename-session to: "  "rename-session '%%'"

# Renumber windows
# bind-key "#" "move-window -r"

# easily toggle synchronization (mnemonic: e is for echo)
# sends input to all panes in a given window.
bind E setw synchronize-panes on \; display "synchronize panes on"
bind e setw synchronize-panes off \; display "synchronize panes off"

## toggle zoom and disable synchronization
bind z setw synchronize-panes off\; resize-pane -Z \; display "toggled zoom"
# bind -n C-z setw synchronize-panes off\; resize-pane -Z \; display "toggled zoom"

# bind presets from M-1..5 to C-q..t
bind C-q select-layout even-horizontal
bind C-w select-layout even-vertical
bind C-e select-layout main-horizontal
bind C-r select-layout main-vertical
bind C-t select-layout tiled

# Patch for OS X pbpaste and pbcopy under tmux.
set-option -g default-command "which reattach-to-user-namespace > /dev/null && reattach-to-user-namespace -l $SHELL || $SHELL"

# Local config
if-shell "[ -f ~/.tmux.conf_extra ]" 'source ~/.tmux.conf_extra'

## PLUGINS
# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'samoshkin/tmux-plugin-sysstat'

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
