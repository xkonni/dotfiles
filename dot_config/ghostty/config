background-opacity = 0.85
background = 14191e
foreground = dbdbdb

font-family = CaskaydiaCove NFM
font-family-bold = CaskaydiaCove NFM Bold
font-family-italic = CaskaydiaCove NFM Italic
font-family-bold-italic = CaskaydiaCove NFM Bold Italic
# font-family = MesloLGM Nerd Font Mono
# font-family-bold = MesloLGM Nerd Font Mono Bold
# font-family-italic = MesloLGM Nerd Font Mono Italic
# font-family-bold-italic = MesloLGM Nerd Font Mono Bold Italic
font-size = 13

term = xterm-256color

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

cursor-style = bar
cursor-color = #5bc8ff

bold-is-bright = true

scrollback-limit = 10000

keybind = ctrl+shift+i=copy_url_to_clipboard


