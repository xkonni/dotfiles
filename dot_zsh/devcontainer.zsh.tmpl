# vim: ft=zsh
# to initialize chezmoi in a devcontainer, we need to set the GITHUB_USER env var
export CHEZMOI_GITHUB_USER=xkonni

{{- if not .devcontainer }}
# only set the user env on the host, not in the devcontainer
{{- if eq .chezmoi.os "darwin" }}
launchctl setenv CHEZMOI_GITHUB_USER xkonni
{{- else if eq .chezmoi.os "linux" }}
[[ -d /run/systemd/private ]] && systemctl --user set-environment CHEZMOI_GITHUB_USER=xkonni
{{- end }}
{{- end }}
