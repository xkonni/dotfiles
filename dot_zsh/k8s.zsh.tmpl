# vim: ft=zsh
{{ if eq .chezmoi.os "darwin" -}}
if ! command -v u8s >/dev/null 2>&1; then
  return 0
fi
k() { u8s kubectl "$@" }
alias kn="u8s set --namespace"
alias kc="u8s set --context"
alias kkc="u8s set --kubeconfig"

h() { u8s helm "$@" }
compdef h=helm
h3() { u8s helm3 "$@" }
compdef h3=helm

{{ else if eq .chezmoi.os "linux" }}
if ! command -v kubectl >/dev/null 2>&1; then
  return 0
fi
k() { kubectl "$@" }
alias kn="kubectl config set-context --current --namespace"
alias kc="kubectl config use-context"

{{ end -}}

compdef k=kubectl

alias ke='k exec -ti'
alias kl='k logs'
alias klf='k logs -f'
alias kg='k get'
alias kgs='k get servers --sort-by=".metadata.labels.kubernetes\.metal\.cloud\.sap/bb"'
alias ky='k get -o yaml'
alias kys='k get servers -o yaml'
alias kga='k get --all-namespaces'
alias kgm='k get -n metal-servers'
alias kgp='k get pods -o wide'
alias kgpa='k get pods -o wide --all-namespaces'
alias kgn='k get nodes -L container-linux-update.v1.coreos.com/version -L failure-domain.beta.kubernetes.io/zone'
alias kds='k describe service'

alias -g OY="-o yaml"
alias -g OYL="-o yaml | bat -l yaml"
alias -g OW="-o wide"

{{ if eq .chezmoi.os "darwin" -}}
function _u8s_env() {
  u8s env | while IFS='=' read -r k v; do export "$k"="$v"; done
}

function _pick-pod() {
    local lines
    lines=$(grep -E "$@" | grep -v Completed | awk '{print $1, $2, $8}')
    [ -z "$lines" ] && return
    local count=$(echo "$lines" | wc -l | tr -d ' ')
    if [ "$count" -le 1 ]; then
        echo "$lines"
    elif command -v fzf &>/dev/null; then
        echo "$lines" | fzf --prompt="Select instance> "
    else
        local -a choices=("${(@f)lines}")
        select choice in "${choices[@]}"; do
            [ -n "$choice" ] && echo "$choice" && break
        done
    fi
}

function _eval-metal() {
    _u8s_env
    if [ -z "$U8S_KUBECONFIG" ]; then
        echo "kubectl KUBECONFIG missing, exiting." >&2
        return 1
    fi
    echo ">> eval-metal in $U8S_CONTEXT"
    local pods
    pods=$(timeout 5 u8s kubectl get pods -A -o wide 2>&1)
    if [[ $? -ne 0 ]]; then
        echo "kubectl failed to get all pods: \"$pods\"" >&2
        return 1
    fi
    read mons mopod mocont <<<$(echo "$pods" | _pick-pod 'metal-operator(-core)?-controller-manager')
    read mmons mmopod mmocont <<<$(echo "$pods" | _pick-pod 'metal-maintenance-operator-controller-manager')
    read bns bpod bcont <<<$(echo "$pods" | _pick-pod 'boot-operator-controller-manager')
    read dns dpod dcont <<<$(echo "$pods" | _pick-pod 'metal-operator-dnsmasq')
    read ans apod acont <<<$(echo "$pods" | _pick-pod -e 'argora-remote-controller-manager' -e 'argora-controller-manager')
    printf ">> %-30s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "metal-operator (mo)" mons "$mons" mopod "$mopod" mocont "$mocont"
    printf ">> %-30s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "metal-maintenance-operator (mmo)" mmons "$mmons" mmopod "$mmopod" mmocont "$mmocont"
    printf ">> %-30s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "boot-operator (b)" bns "$bns" bpod "$bpod" bcont "$bcont"
    printf ">> %-30s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "dnsmasq (d)" dns "$dns" dpod "$dpod" dcont "$dcont"
    printf ">> %-30s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "argora-remote (a)" ans "$ans" apod "$apod" acont "$acont"
    export mons mopod mocont mmons mmopod mmocont bns bpod bcont dns dpod dcont ans apod acont
}

function _pod-ns() {
    case $1 in
        mo)  echo "$mons $mopod" ;;
        mmo) echo "$mmons $mmopod" ;;
        b)   echo "$bns $bpod" ;;
        d)   echo "$dns $dpod" ;;
        a)   echo "$ans $apod" ;;
        *) echo "Unknown component: $1" >&2; return 1 ;;
    esac
}

function _env-check() {
    case $1 in
        mo)
            if [ -z "$mons" ] || [ -z "$mopod" ]; then
                echo "no metal-operator env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        mmo)
            if [ -z "$mmons" ] || [ -z "$mmopod" ]; then
                echo "no metal-maintenance-operator env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        b)
            if [ -z "$bns" ] || [ -z "$bpod" ]; then
                echo "no boot-operator env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        d)
            if [ -z "$dns" ] || [ -z "$dpod" ]; then
                echo "no dnsmasq env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        a)
            if [ -z "$ans" ] || [ -z "$apod" ]; then
                echo "no argora-remote env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        *)
            echo "Unknown component: $1, expected mo, mmo, b, d, a." >&2
            return 1
            ;;
    esac
}

function _print-secret() {
    local raw=${1:-0}
    local json; json=$(cat)
    if (( raw )); then
        jq -r '.data | to_entries[] | "\(.key)\t\(.value)"' <<< "$json"
    else
        jq -r '.data | to_entries[] | "\(.key)\t\(if (.value | @base64d | test("^[[:print:]\\n\\r\\t]*$")) then (.value | @base64d) else "[binary, \(.value | @base64d | length) bytes]" end)"' <<< "$json"
    fi
}

function _kube-logs() {
    if [ $# -lt 2 ]; then
        echo "Usage: _kube-logs <namespace> <podname>" >&2
        return 1
    fi
    ns=$1
    pod=$2
    shift 2
    if [ -z "$U8S_KUBECONFIG" ]; then
        echo "k KUBECONFIG missing, exiting." >&2
        return 1
    fi
    local logdir=$HOME/workspace/logs/${U8S_CONTEXT:-no-context}
    mkdir -p "$logdir"
    LOGFILE=$logdir/$(date +%Y%m%d_%H%M%S)_${pod}.log
    trap 'echo -e "\n\n> aborted.\n> logs saved to $LOGFILE"; return' INT
    k logs $* -n $ns $pod 2>&1 | tee $LOGFILE
    [ $? ] && echo -e "\n\n> logs saved to $LOGFILE"
    trap - INT
}

function kk() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $0 <eval|leases|logs|describe|bmcsecret|secret|ssh|curl> [args...]" >&2; return 1
    fi
    local action=$1; shift
    case $action in
        logs)
            local -a flags
            while [[ $1 == -* ]]; do flags+=($1); shift; done
            _env-check $1 || return 1
            local comp=$1; shift
            local pod_ns=$(_pod-ns $comp) || return 1
            _kube-logs ${=pod_ns} "${flags[@]}" "$@"
            ;;
        describe)
            _env-check $1 || return 1
            local pod_ns=$(_pod-ns $1) || return 1; shift
            k describe pod -n ${=pod_ns} "$@"
            ;;
        leases)
            _env-check d || return 1
            local do_ping=0 filter=
            while [[ $1 == -* ]]; do
                case $1 in
                    -p) do_ping=1; shift ;;
                    -l) filter=$2; shift 2 ;;
                    -h|--help)
                        echo "Usage: $0 leases [-p] [-l <filter>]"
                        echo "  -p          ping each IP to check reachability"
                        echo "  -l <filter> grep leases by filter string"
                        return 0 ;;
                    *) break ;;
                esac
            done
            echo "> leases from ns: \"$dns\" pod: \"$dpod\" /var/lib/misc/dnsmasq.leases:"
            local raw
            raw=$(k exec -i -n $dns $dpod -- cat /var/lib/misc/dnsmasq.leases \
                | { [[ -n $filter ]] && grep "$filter" || cat; })
            local -A mac_ips
            while read -r _ mac ip _; do
                [[ -n $mac && -n $ip ]] || continue
                mac_ips[$mac]+="$ip "
            done <<< "$raw"
            for mac in ${(ko)mac_ips}; do
                echo "- $mac"
                for ip in ${=mac_ips[$mac]}; do
                    if (( do_ping )); then
                        timeout 0.5 ping -c 1 $ip &>/dev/null && echo "  - $ip · YES" || echo "  - $ip · no"
                    else
                        echo "  - $ip"
                    fi
                done
            done
            ;;
        secret)
            if [[ $# -lt 1 ]]; then
                echo "Usage: $0 secret [-r] <secret> [namespace]" >&2; return 1
            fi
            local raw=0; [[ $1 == -r ]] && { raw=1; shift }
            local secret=$1 ns=$2
            local json ns_flag=()
            [[ -n $ns ]] && ns_flag=(-n "$ns")
            json=$(k get secret "${ns_flag[@]}" "$secret" -o json 2>/dev/null)
            if [[ -z $json && $secret != *-system-* ]]; then
                json=$(k get secret "${ns_flag[@]}" "${secret}-system-0" -o json 2>/dev/null)
            fi
            [[ -z $json ]] && { echo "Error: secret \"$secret\" not found${ns:+ in namespace \"$ns\"}" >&2; return 1 }
            _print-secret $raw <<< "$json"
            ;;
        bmcsecret)
            if [[ $# -lt 1 ]]; then
                echo "Usage: $0 bmcsecret [-r] <name>" >&2; return 1
            fi
            local raw=0; [[ $1 == -r ]] && { raw=1; shift }
            local name=$1
            local json
            json=$(k get bmcsecrets.metal.ironcore.dev "$name" -o json 2>/dev/null)
            [[ -z $json ]] && { echo "Error: bmcsecret \"$name\" not found" >&2; return 1 }
            _print-secret $raw <<< "$json"
            ;;
        ssh)
            if [[ $# -lt 1 ]]; then
                echo "Usage: $0 ssh <node> [user] [namespace]" >&2; return 1
            fi
            local node=$1
            [[ "$node" != *-system-* ]] && node="${node}-system-0"
            local user=${2:-metal} ns=$3
            mkdir -p ~/workspace/ssh-keys && chmod 700 ~/workspace/ssh-keys
            local key value secret_user= secret_pass= has_key=0
            while IFS=$'\t' read -r key value; do
                case $key in
                    pem)      base64 -d <<< "$value" > ~/workspace/ssh-keys/id_${node}; chmod 600 ~/workspace/ssh-keys/id_${node}; echo "key: ~/workspace/ssh-keys/id_${node}"; has_key=1 ;;
                    pub)      base64 -d <<< "$value" > ~/workspace/ssh-keys/id_${node}.pub; chmod 600 ~/workspace/ssh-keys/id_${node}.pub; echo "pub: ~/workspace/ssh-keys/id_${node}.pub" ;;
                    username) secret_user=$(base64 -d <<< "$value"); echo "username: $secret_user" ;;
                    password) secret_pass=$(base64 -d <<< "$value"); echo "password: $secret_pass" ;;
                    *)        echo "$key: $value" ;;
                esac
            done < <($0 secret -r "${node}-ssh" "$ns")
            [[ -n $secret_user ]] && user=$secret_user
            if (( has_key )); then
                alias ssh-$node="ssh -l $user -i ~/workspace/ssh-keys/id_${node} -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
            else
                alias ssh-$node="sshpass -p '$secret_pass' ssh -l $user -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
            fi
            echo "alias: ssh-$node <IP>"
            ;;
        curl)
            local pipe=cat node= curl_args=()
            for arg in "$@"; do
                case $arg in
                    -j) pipe=jq ;;
                    -y) pipe=yq ;;
                    *)  [[ -z $node ]] && node=$arg || curl_args+=("$arg") ;;
                esac
            done
            if [[ -z $node ]]; then
                echo "Usage: $0 curl [-j|-y] <node> [curl args...]" >&2; return 1
            fi
            local user pass
            while IFS=$'\t' read -r key val; do
                case $key in
                    username) user=$val ;;
                    password) pass=$val ;;
                esac
            done < <($0 bmcsecret "$node")
            [[ -z $user || -z $pass ]] && { echo "Error: could not extract credentials from bmcsecret \"$node\"" >&2; return 1 }
            curl -u "$user:$pass" "${curl_args[@]}" | $pipe
            ;;
        eval)
            _eval-metal
            ;;
        *)
            echo "Usage: $0 <eval|leases|logs|describe|bmcsecret|secret|ssh|curl> [args...]" >&2; return 1
            ;;
    esac
}

function kping() {
    while read -r _ _ ip _; do
        echo -en "$ip: "
        timeout 0.5 ping -c 1 $ip &>/dev/null && echo yes || echo no
    done
}
{{- end }}
