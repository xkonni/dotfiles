# vim: ft=zsh
{{ if eq .chezmoi.os "darwin" -}}
if ! command -v u8s >/dev/null 2>&1; then
  return 0
fi
k() { u8s kubectl "$@" }
alias kn="u8s set --namespace"
alias kc="u8s set --context"
alias kk="u8s set --kubeconfig"

h() { u8s helm "$@" }
compdef h=helm
h3() { u8s helm3 "$@" }
compdef h3=helm

{{ else if eq .chezmoi.os "linux" }}
if ! command -v kubectl >/dev/null 2>&1; then
  return 0
fi
k() { kubectl "$@" }
alias kn="kubectl config set-context --current --namespace"
alias kc="kubectl config use-context"

{{ end -}}

compdef k=kubectl

alias ke='k exec -ti'
alias kl='k logs'
alias klf='k logs -f'
alias kg='k get'
alias ky='k get -o yaml'
alias kga='k get --all-namespaces'
alias kgm='k get -n metal-servers'
alias kgp='k get pods -o wide'
alias kgpa='k get pods -o wide --all-namespaces'
alias kgn='k get nodes -L container-linux-update.v1.coreos.com/version -L failure-domain.beta.kubernetes.io/zone'
alias kds='k describe service'

alias -g OY="-o yaml"
alias -g OYL="-o yaml | bat -l yaml"
alias -g OW="-o wide"

{{ if eq .chezmoi.os "darwin" -}}
function _u8s_env() {
  u8s env | while IFS='=' read -r k v; do export "$k"="$v"; done
}

function _pick-pod() {
    local lines
    lines=$(k get pods --all-namespaces -o wide | grep "$@" | grep -v Completed | awk '{print $1, $2, $8}')
    [ -z "$lines" ] && return
    local count=$(echo "$lines" | wc -l | tr -d ' ')
    if [ "$count" -le 1 ]; then
        echo "$lines"
    elif command -v fzf &>/dev/null; then
        echo "$lines" | fzf --prompt="Select instance> "
    else
        local -a choices=("${(@f)lines}")
        select choice in "${choices[@]}"; do
            [ -n "$choice" ] && echo "$choice" && break
        done
    fi
}

function _eval-metal() {
    _u8s_env
    if [ -z "$U8S_KUBECONFIG" ]; then
        echo "kubectl KUBECONFIG missing, exiting." >&2
        return 1
    fi
    echo ">> eval-metal in $U8S_CONTEXT"
    read mns mpod mcont <<<$(_pick-pod 'metal-operator-controller-manager')
    read bns bpod bcont <<<$(_pick-pod 'boot-operator-controller-manager')
    read dns dpod dcont <<<$(_pick-pod 'metal-operator-dnsmasq')
    read ans apod acont <<<$(_pick-pod -e 'argora-remote-controller-manager' -e 'argora-controller-manager')
    printf ">> %-15s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "metal-operator" mns "$mns" mpod "$mpod" mcont "$mcont"
    printf ">> %-15s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "boot-operator" bns "$bns" bpod "$bpod" bcont "$bcont"
    printf ">> %-15s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "dnsmasq" dns "$dns" dpod "$dpod" dcont "$dcont"
    printf ">> %-15s\n>  %3s=%-20s %4s=%-50s %5s=%s\n" \
        "argora-remote" ans "$ans" apod "$apod" acont "$acont"
    export mns mpod mcont bns bpod bcont dns dpod dcont ans apod acont
}

function _env-check() {
    case $1 in
        m*)
            if [ -z "$mns" ] || [ -z "$mpod" ]; then
                echo "no metal-operator env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        b*)
            if [ -z "$bns" ] || [ -z "$bpod" ]; then
                echo "no boot-operator env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        d*)
            if [ -z "$dns" ] || [ -z "$dpod" ]; then
                echo "no dnsmasq env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        a*)
            if [ -z "$ans" ] || [ -z "$apod" ]; then
                echo "no argora-remote env found, run eval-metal first." >&2
                return 1
            fi
            ;;
        *)
            echo "Unknown component prefix: $1, expected m*, b*, d* or a*." >&2
            return 1
            ;;
    esac
}

function _kube-logs() {
    if [ $# -lt 2 ]; then
        echo "Usage: _kube-logs <namespace> <podname>" >&2
        return 1
    fi
    ns=$1
    pod=$2
    shift 2
    if [ -z "$U8S_KUBECONFIG" ]; then
        echo "k KUBECONFIG missing, exiting." >&2
        return 1
    fi
    LOGFILE=$HOME/log/$(date +%Y%m%d_%H%M%S)_${pod}.log
    trap 'echo -e "\n\n> aborted.\n> logs saved to $LOGFILE"; return' INT
    k logs $* -n $ns $pod 2>&1 | tee $LOGFILE
    [ $? ] && echo -e "\n\n> logs saved to $LOGFILE"
    trap - INT
}

function kkg() {
    local action=$1; shift
    case $action in
        logs)
            _env-check $1 || return 1
            local comp=$1; shift
            case $comp in
                m*) _kube-logs $mns $mpod "$@" ;;
                b*) _kube-logs $bns $bpod "$@" ;;
                d*) _kube-logs $dns $dpod "$@" ;;
                a*) _kube-logs $ans $apod "$@" ;;
                *) echo "Unknown component prefix: $comp" >&2; return 1 ;;
            esac
            ;;
        leases)
            _env-check d || return 1
            local do_ping=0 filter=
            while [[ $1 == -* ]]; do
                case $1 in
                    -p) do_ping=1; shift ;;
                    -l) filter=$2; shift 2 ;;
                    *) break ;;
                esac
            done
            echo "> leases from ns: \"$dns\" pod: \"$dpod\" /var/lib/misc/dnsmasq.leases:"
            local raw
            raw=$(k exec -i -n $dns $dpod -- cat /var/lib/misc/dnsmasq.leases \
                | { [[ -n $filter ]] && grep "$filter" || cat; })
            local -A mac_ips
            while read -r _ mac ip _; do
                [[ -n $mac && -n $ip ]] || continue
                mac_ips[$mac]+="$ip "
            done <<< "$raw"
            for mac in ${(ko)mac_ips}; do
                echo "- $mac"
                for ip in ${=mac_ips[$mac]}; do
                    if (( do_ping )); then
                        timeout 0.5 ping -c 1 $ip &>/dev/null && echo "  - $ip · YES" || echo "  - $ip · no"
                    else
                        echo "  - $ip"
                    fi
                done
            done
            ;;
        secret)
            if [[ $# -lt 1 ]]; then
                echo "Usage: $0 secret [-r] <secret> [namespace]" >&2; return 1
            fi
            local raw=0; [[ $1 == -r ]] && { raw=1; shift }
            local secret=$1 ns=${2:-metal-servers}
            local json
            json=$(k get secret -n "$ns" "$secret" -o json 2>/dev/null)
            if [[ -z $json && $secret != *-system-* ]]; then
                json=$(k get secret -n "$ns" "${secret}-system-0" -o json 2>/dev/null)
            fi
            [[ -z $json ]] && { echo "Error: secret \"$secret\" not found in namespace \"$ns\"" >&2; return 1 }
            if (( raw )); then
                jq -r '.data | to_entries[] | "\(.key)\t\(.value)"' <<< "$json"
            else
                jq -r '.data | to_entries[] | "=== \(.key) ===\n\(.value | @base64d)\n"' <<< "$json"
            fi
            ;;
        ssh)
            if [[ $# -lt 1 ]]; then
                echo "Usage: $0 ssh <node> [user] [namespace]" >&2; return 1
            fi
            local node=$1
            [[ "$node" != *-system-* ]] && node="${node}-system-0"
            local user=${2:-metal} ns=${3:-metal-servers}
            mkdir -p ssh-keys && chmod 700 ssh-keys
            local key b64 value
            while IFS=$'\t' read -r key b64; do
                value=$(base64 -d <<< "$b64")
                case $key in
                    pem) printf '%s\n' "$value" > "ssh-keys/id_${node}"; chmod 600 "ssh-keys/id_${node}"; echo "pem: ssh-keys/id_${node}" ;;
                    pub) printf '%s\n' "$value" > "ssh-keys/id_${node}.pub"; chmod 600 "ssh-keys/id_${node}.pub"; echo "pub: ssh-keys/id_${node}.pub" ;;
                    *)   echo "$key: $value" ;;
                esac
            done < <($0 secret -r "${node}-ssh" "$ns")
            alias ssh-$node="ssh -l $user -i ssh-keys/id_${node} -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
            echo "alias: ssh-$node <IP>"
            ;;
        eval)
            _eval-metal
            ;;
        *)
            echo "Usage: $0 <eval|leases|logs|secret|ssh> [args...]" >&2; return 1
            ;;
    esac
}

function kping() {
    while read -r _ _ ip _; do
        echo -en "$ip: "
        timeout 0.5 ping -c 1 $ip &>/dev/null && echo yes || echo no
    done
}
{{- end }}
