# vim: ft=zsh
{{ if eq .chezmoi.os "darwin" -}}
SSH_AUTH_SOCK=$(launchctl getenv SSH_AUTH_SOCK)
{{- else if eq .chezmoi.os "linux" -}}
[[ -z "$SSH_AUTH_SOCK" || ! -e "$SSH_AUTH_SOCK" ]] && SSH_AUTH_SOCK=/run/user/$(id -u)/gcr/ssh
{{- end }}

{{ if .devcontainer -}}
# In devcontainer: fallback to discovering agent socket from mounted ~/.ssh directory
if [ -z "$SSH_AUTH_SOCK" ] || [ ! -e "$SSH_AUTH_SOCK" ]; then
  agent_socket=$(ls -1t $HOME/.ssh/agent/* 2>/dev/null | head -1)
  if [ -e "$agent_socket" ]; then
    SSH_AUTH_SOCK="$agent_socket"
  fi
fi
{{ end -}}

SSH_AUTH_SOCK_FILE=~/.ssh/SSH_AUTH_SOCK
LOGDIRS=(/run/user/$(id -u) /var/tmp/)
LOGFILE=ssh_auth_sock.log

function _log() {
  for logdir in "${LOGDIRS[@]}"; do
    if [[ -d "$logdir" ]]; then
      echo $* >>$logdir/$LOGFILE
      return
    fi
  done
}

# Save SSH_AUTH_SOCK to file and set environment
function ssh_save() {
  if [ -e "$SSH_AUTH_SOCK" ]; then
    _ssh_save_file
    export SSH_AUTH_SOCK
    _l2 "saved " green "$SSH_AUTH_SOCK"
  elif [ -e "$SSH_AUTH_SOCK_FILE" ] && [ -e "$(cat $SSH_AUTH_SOCK_FILE)" ]; then
    SSH_AUTH_SOCK=$(cat $SSH_AUTH_SOCK_FILE)
    export SSH_AUTH_SOCK
    _l2 "loaded" none "$SSH_AUTH_SOCK"
  else
    _log "ERROR: no valid SSH_AUTH_SOCK"
    _he1 "ssh: no valid SSH_AUTH_SOCK"
    return 1
  fi
  _ssh_set_env
}

# Load SSH_AUTH_SOCK from file
function ssh_load() {
  local sock
  if [ -e "$SSH_AUTH_SOCK_FILE" ]; then
    sock=$(cat $SSH_AUTH_SOCK_FILE)
    if [ -e "$sock" ]; then
      SSH_AUTH_SOCK=$sock
      export SSH_AUTH_SOCK
      [ -n "$SSH_CLIENT" ] && _log "loaded SSH_AUTH_SOCK: $SSH_AUTH_SOCK"
      _l2 "loaded" green "$SSH_AUTH_SOCK"
      _ssh_set_env
    else
      _log "ERROR: invalid socket: $sock"
      _lw2 "socket" none "invalid: $sock"
    fi
  else
    sock=$(gpgconf --list-dirs agent-ssh-socket 2>/dev/null)
    if [ -n "$sock" ]; then
      SSH_AUTH_SOCK=$sock
      export SSH_AUTH_SOCK
      _log "using gpgconf SSH_AUTH_SOCK: $SSH_AUTH_SOCK"
      _l2 "loaded" none "$SSH_AUTH_SOCK (gpgconf)"
      _ssh_set_env
    else
      _log "ERROR: missing file \"$SSH_AUTH_SOCK_FILE\""
      _he1 "ssh: missing file \"$SSH_AUTH_SOCK_FILE\""
    fi
  fi
}

function _ssh_set_env() {
  if [ -n "$SSH_AUTH_SOCK" ]; then
    {{ if eq .chezmoi.os "darwin" -}}
    launchctl setenv SSH_AUTH_SOCK $SSH_AUTH_SOCK
    {{- else if eq .chezmoi.os "linux" -}}
    grep -q init.scope /proc/1/cgroup && systemctl --user set-environment SSH_AUTH_SOCK=${SSH_AUTH_SOCK}
    {{- end }}
  fi
}

function setupssh() {
  eval $(keychain --quiet --eval)
  ssh_save
  _h2 "ssh-agent running, SSH_AUTH_SOCK: $SSH_AUTH_SOCK"
  _h2 "identity list:"
  ssh-add -l | while read line; do _l2 "$line"; done
}

function rtssh() {
    while true
    do
        ssh $*
        echo "retrying in 3..."
        sleep 3
    done
}

function _ssh_save_file() {
  _log "saving SSH_AUTH_SOCK: $SSH_AUTH_SOCK to file: $SSH_AUTH_SOCK_FILE"
  echo $SSH_AUTH_SOCK > $SSH_AUTH_SOCK_FILE
}

{{ if eq .chezmoi.os "linux" -}}
export SSH_AUTH_SOCK
{{- end }}
