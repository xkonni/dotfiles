# SSH
alias S='ssh'
alias SA='ssh-add'
alias SL='ssh-add -l'
alias SE='eval $(keychain --eval)'
function rtssh() {
    while true
    do
        ssh $*
        echo "retrying in 3..."
        sleep 3
    done
}

# CLIPBOARD
{{ if eq .chezmoi.os "darwin" -}}
alias -g CP='| pbcopy'
alias PS='pbpaste'
{{ else if eq .chezmoi.os "linux" -}}
alias -g CP='| wl-copy'
alias PS='wl-paste'
{{ end -}}
function CPF() {
    cat $1 CP
}
function PSF() {
    PS | tee $1
}
function PSA() {
    PS | tee -a $1
}

# WATCH
function WT() {
    local timeout=10 clr
    local -a clr_opt timeout_opt help_opt

    zparseopts -D -E -- \
        c=clr_opt       \
        t:=timeout_opt  \
        h=help_opt      \
        -help=help_opt  \
    || return 1
    [[ $1 == -- ]] && shift

    (( $#help_opt    )) && { echo "Usage: WT [-c] [-t timeout] command..."; return 0 }
    (( $#clr_opt     )) && clr=true
    (( $#timeout_opt )) && timeout=${timeout_opt[2]}

    local count=1
    while true; do
        [[ -n $clr ]] && clear >/dev/tty
        echo -e "\n>> [$(date '+%Y-%m-%d %H:%M:%S')] [$count] $*" >/dev/tty
        eval "$@"
        let count+=1
        sleep $timeout
    done
}

globalias() {
  if [[ $LBUFFER =~ '[A-Z0-9]+$' ]]; then
    zle _expand_alias
    zle expand-word
  fi
  # zle self-insert # inserts keys used to activate
  print -n " "
}
zle -N globalias
# bindkey " " globalias                 # space key to expand globalalias
# bindkey "^ " magic-space              # control-space to bypass completion
bindkey -M emacs "^ " globalias                 # space key to expand globalalias
bindkey -M viins "^ " globalias                 # space key to expand globalalias
bindkey -M emacs " " magic-space              # control-space to bypass completion
bindkey -M viins " " magic-space              # control-space to bypass completion
bindkey -M isearch " " magic-space    # normal space during searches
