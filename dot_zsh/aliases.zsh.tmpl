# These aliases enable us to paste example code into the terminal without the
# shell complaining about the pasted prompt symbol.
alias %= \$=

# zmv lets you batch rename (or copy or link) files by using pattern matching.
# https://zsh.sourceforge.io/Doc/Release/User-Contributions.html#index-zmv
autoload -Uz zmv
alias zmv='zmv -Mv'
alias zcp='zmv -Cv'
alias zln='zmv -Lv'

# usability
if type -p eza &> /dev/null
then
    alias l='eza --git --group-directories-first --icons --smart-group'
    alias lt='l -l --sort newest'
    alias llf='l -lf'                                       # files only, long format
    alias lld='l -lD'                                       # directories only, long format
    alias llh='l -l --hyperlink'                            # long format with hyperlink
elif type -p lsd &> /dev/null
then
    alias l='lsd --group-directories-first'
    alias lt='l -l --sort time --reverse'
else
    alias l='ls'
{{- if eq .chezmoi.os "darwin" }}
    alias l='ls -G'
{{- else }}
    alias l='ls --color=auto'
{{- end }}
    alias lt='l -ltr'
fi
alias la='l -a'
alias ll='l -l'
alias lla='l -al'

# default options for less
export LESS='-F -j4'

# c -> bat/batcat or cat
bat=( /usr/bin/bat(N) /usr/bin/batcat(N) /opt/homebrew/bin/bat(N) )
if type -p ${bat:0:1} &> /dev/null
then
    BAT_CMD=${bat:0:1}
    c() {
        if [[ $# -eq 1 && $1 == *.md ]] && type -p glow &> /dev/null; then
            glow -w 120 "$1"
        else
            ${BAT_CMD} --paging=never "$@"
        fi
    }
    alias B="| bat"
    export MANPAGER="sh -c \"col -bx | ${BAT_CMD} -p -l man\""
    export MANROFFOPT="-P -c"
    help() {
        "$@" --help 2>&1 | ${BAT_CMD} --plain --language=help
    }
else
    alias c=cat
fi


# fd -> fdfind
fdfind=( /usr/bin/fd(N) /usr/bin/fdfind(N) )
if type -p ${fdfind:0:1} &> /dev/null
then
    FD_CMD=${fdfind:0:1}
    if [[ "$FD_CMD" != */fd ]]; then
        alias fd=${FD_CMD}
    fi
fi

# fz
if type -p fzf &> /dev/null && [[ -n "$BAT_CMD" ]] && [[ -n "$FD_CMD" ]]
then
    alias fz="${FD_CMD} --type f . | fzf --preview \"${BAT_CMD} --color=always --style=numbers {}\" | xargs -d \"\n\" -I{} ${BAT_CMD} {}"
    alias fzv="${FD_CMD} --type f . | fzf --preview \"${BAT_CMD} --color=always --style=numbers {}\" | xargs -d \"\n\" -I{} vim {}"
{{ if eq .chezmoi.os "darwin" -}}
    alias fzo="${FD_CMD} --type f . | fzf --preview \"${BAT_CMD} --color=always --style=numbers {}\" | xargs -d \"\n\" -I{} open {}"
{{ else if eq .chezmoi.os "linux" -}}
    alias fzo="${FD_CMD} --type f . | fzf --preview \"${BAT_CMD} --color=always --style=numbers {}\" | xargs -d \"\n\" -I{} xdg-open {}"
{{ end -}}
fi

