#!/usr/bin/env zsh
# Usage: zettlr-theme rose-pine
#        zettlr-theme none

ZETTLR="$HOME/Library/Application Support/Zettlr"
BASE="$ZETTLR/custom.css"
THEMES_DIR="$ZETTLR/themes"
THEME="${1%.css}"

if [[ -z "$THEME" ]]; then
    echo "Usage: zettlr-theme <theme-name|none>"
    echo "Available themes:"
    for f in "$THEMES_DIR"/*.css; do echo "  $(basename "$f" .css)"; done
    exit 1
fi

# Strip existing theme block
content=$(sed '/\/\* THEME_START/,/THEME_END \*\//d' "$BASE")

if [[ "$THEME" == "none" ]]; then
    printf '%s\n/* THEME_START — do not edit this line */\n/* THEME_END — do not edit this line */\n' "$content" > "$BASE"
    echo "Theme cleared."
    exit 0
fi

THEME_FILE="$THEMES_DIR/$THEME.css"
if [[ ! -f "$THEME_FILE" ]]; then
    echo "Theme not found: $THEME_FILE"
    exit 1
fi

{
    printf '%s\n' "$content"
    echo "/* THEME_START — do not edit this line */"
    cat "$THEME_FILE"
    echo "/* THEME_END — do not edit this line */"
} > "$BASE"

echo "Theme '$THEME' applied. Reload Zettlr to see changes."
